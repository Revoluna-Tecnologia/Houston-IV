{
  "name": "@houston/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "docker compose -f docker-compose.test.yml up -d && vitest run -c vitest.config.integration.ts",
    "test:integration:watch": "docker compose -f docker-compose.test.yml up -d && vitest -c vitest.config.integration.ts",
    "test:e2e": "docker compose -f docker-compose.test.yml up -d && vitest run -c vitest.config.e2e.ts",
    "test:e2e:watch": "docker compose -f docker-compose.test.yml up -d && vitest -c vitest.config.e2e.ts",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "clean": "rm -rf dist .turbo coverage",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/platform-socket.io": "^11.1.10",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.10",
    "@prisma/client": "^6.1.0",
    "@thallesp/nestjs-better-auth": "^2.2.0",
    "@upstash/redis": "^1.34.3",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "5",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.5.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.6.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@houston/tsconfig": "workspace:*",
    "@houston/types": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^11.1.12",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "^6.1.0",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vitest-mock-extended": "^3.1.0"
  }
}

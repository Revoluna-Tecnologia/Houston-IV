{
  "name": "houston-iv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:cov": "turbo test:cov",
    "test:integration": "turbo test:integration",
    "test:e2e": "pnpm --filter @houston/web test:e2e",
    "test:all": "turbo test && turbo test:integration && pnpm --filter @houston/web test:e2e",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "pnpm --filter @houston/api db:push",
    "db:migrate": "pnpm --filter @houston/api db:migrate",
    "db:studio": "pnpm --filter @houston/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}

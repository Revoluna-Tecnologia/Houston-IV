# Database
DATABASE_URL="postgresql://user:password@localhost:5432/houston?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3001"

# CORS - Múltiplas origens separadas por vírgula
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth Microsoft (opcional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Email via Resend (opcional)
RESEND_API_KEY=""
EMAIL_FROM="noreply@example.com"

# Redis/Upstash para rate limiting (opcional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# WhatsApp Provider (zapster | twilio | meta)
WHATSAPP_PROVIDER="zapster"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=26214400

# Trusted Origins (Better Auth)
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Server
PORT=3001
NODE_ENV="development"

# Logs
LOG_LEVEL="debug"

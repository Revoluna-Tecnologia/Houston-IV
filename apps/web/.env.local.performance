# Variáveis para melhorar performance de desenvolvimento

# Desabilita Turbopack se estiver causando problemas
# (remova o --turbopack do script dev em package.json se usar isso)
# TURBOPACK_DISABLE=1

# Aumenta heap memory do Node.js (útil para builds grandes)
NODE_OPTIONS="--max-old-space-size=4096"

# Desabilita telemetria do Next.js (pequena melhoria)
NEXT_TELEMETRY_DISABLED=1

# API URL (local ou remoto)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Modo de desenvolvimento
NODE_ENV=development
